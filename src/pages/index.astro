---
import Layout from '../layouts/Layout.astro';
import { profile, links } from '../data/profile';
import { projects } from '../data/projects';
import { publications } from '../data/publications';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const previewPosts = posts.slice(0, 3);

const iconPaths: Record<string, string> = {
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.15 1.46-2.15 2.97V21h-4V9Z',
  github:
    'M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.5v-1.94c-2.78.62-3.37-1.36-3.37-1.36-.46-1.2-1.11-1.52-1.11-1.52-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.34 1.12 2.91.86.09-.66.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.72 0 0 .84-.27 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.32 2.75-1.05 2.75-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.78-4.57 5.04.36.32.68.94.68 1.9v2.82c0 .28.18.61.69.5A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z',
  orcid:
    'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2ZM7.9 7.15a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3ZM7.15 10.7h1.5v8.05h-1.5V10.7Zm3.4 0h3.1c2.95 0 4.25 2.1 4.25 4.02 0 2.1-1.64 4.03-4.23 4.03h-3.12V10.7Zm1.5 1.34v5.36h1.5c2.1 0 2.9-1.5 2.9-2.67 0-1.44-.9-2.69-2.93-2.69h-1.47Z',
  email:
    'M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5v-13Zm2.2.5 7.3 6.1a.75.75 0 0 0 .96 0L19.8 6H4.2ZM20 7.4l-6.85 5.72a2.25 2.25 0 0 1-2.9 0L3.4 7.4V18h16.6V7.4Z',
};

const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long' });
---

<Layout title="Khaled Eissa — AI/Software Engineer">
  <section class="wrap hero">
    <h1>{profile.name}</h1>
    <p class="role">{profile.title}</p>
    <p class="summary">{profile.summary}</p>

    <ul class="link-row" aria-label="Contact and profile links">
      {
        links.map((l) => (
          <li>
            <a
              class="pill link-underline"
              href={l.url}
              target={l.icon === 'email' ? undefined : '_blank'}
              rel={l.icon === 'email' ? undefined : 'noopener noreferrer'}
            >
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path fill="currentColor" d={iconPaths[l.icon]} />
              </svg>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section" id="projects">
    <h2 class="section-title">Projects</h2>
    <ul class="stack">
      {
        projects.map((p) => (
          <li class="item">
            <a
              class="item-title link-underline"
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {p.title}
            </a>
            <p class="item-desc">{p.description}</p>
            <a
              class="item-meta"
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              github.com/{p.url.split('/').slice(-2).join('/')}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section" id="blogs">
    <div class="section-head">
      <h2 class="section-title">Blogs</h2>
      <a href="/blogs" class="see-all link-underline">All blogs</a>
    </div>
    <ul class="stack">
      {
        previewPosts.map((post) => (
          <li class="item">
            <a class="item-title link-underline" href={`/blogs/${post.id}`}>
              <span transition:name={`post-title-${post.id}`}>{post.data.title}</span>
            </a>
            <p class="item-meta standalone">{dateFmt.format(post.data.date)}</p>
            <p class="item-desc">{post.data.excerpt}</p>
          </li>
        ))
      }
      {
        previewPosts.length === 0 && (
          <li class="item">
            <p class="item-desc">No posts yet — check back soon.</p>
          </li>
        )
      }
    </ul>
  </section>

  <section class="wrap section" id="publications">
    <h2 class="section-title">Publications</h2>
    <ul class="stack">
      {
        publications.map((pub) => (
          <li class="item">
            <a
              class="item-title link-underline"
              href={pub.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {pub.title}
            </a>
            <p class="item-meta standalone">
              {pub.venue} &middot; {pub.date} &middot; DOI: {pub.doi}
            </p>
            <p class="item-desc abstract">{pub.abstract}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .hero {
    padding: 4.5rem 1.5rem 3rem;
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    margin-top: 0.5rem;
    color: var(--text);
  }

  .role {
    font-family: var(--font-display);
    color: var(--accent);
    font-size: 1.05rem;
    margin: 0.6rem 0 0;
  }

  .summary {
    margin-top: 1.1rem;
    max-width: 34rem;
    font-size: 1.02rem;
  }

  .link-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.9rem;
    padding: 0;
    margin: 1.75rem 0 0;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .pill svg {
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .pill:hover,
  .pill:focus-visible {
    color: var(--text);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-head .section-title {
    margin-bottom: 0;
  }

  .see-all {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.9rem;
  }

  .item-title {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--text);
  }

  .item-desc {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
  }

  .item-desc.abstract {
    color: var(--text-faint);
  }

  .item-meta {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.82rem;
    color: var(--text-faint);
  }

  .item-meta.standalone {
    margin-top: 0.3rem;
  }
</style>
