---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={`${post.data.title} — Khaled Eissa`} description={post.data.excerpt}>
  <article class="wrap post">
    <a href="/blogs" class="back link-underline">&larr; All blogs</a>

    <header class="post-header">
      <h1 transition:name={`post-title-${post.id}`}>{post.data.title}</h1>
      <p class="post-date">{dateFmt.format(post.data.date)}</p>
    </header>

    {
      post.data.coverImage && (
        <Image
          src={post.data.coverImage}
          alt={post.data.coverImageAlt ?? ''}
          class="cover"
          widths={[400, 800, 1200]}
          sizes="(max-width: 700px) 100vw, 700px"
        />
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      post.data.references && post.data.references.length > 0 && (
        <section class="refs">
          <h2>References</h2>
          <ul>
            {post.data.references.map((ref) => (
              <li>
                <a href={ref.url} class="link-underline" target="_blank" rel="noopener noreferrer">
                  {ref.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Layout>

<style>
  .post {
    padding: 3rem 1.5rem 5rem;
  }

  .back {
    display: inline-block;
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 2.25rem;
  }

  .post-header h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
  }

  .post-date {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .cover {
    width: 100%;
    height: auto;
    margin: 2.25rem 0;
    border-radius: 4px;
    border: 1px solid var(--line);
  }

  .prose {
    margin-top: 2.25rem;
    font-size: 1.02rem;
  }

  .prose :global(p) {
    color: var(--text);
    margin: 0 0 1.3em;
  }

  .prose :global(h2) {
    font-size: 1.25rem;
    margin: 2.4em 0 0.9em;
    color: var(--text);
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--accent);
    text-underline-offset: 2px;
    text-decoration: underline;
    text-decoration-color: var(--accent-dim);
  }

  .prose :global(ul),
  .prose :global(ol) {
    color: var(--text);
    padding-left: 1.3em;
  }

  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding-left: 1em;
    border-left: 2px solid var(--accent-dim);
    color: var(--text-muted);
  }

  .prose :global(img) {
    border-radius: 4px;
    margin: 1.5em 0;
  }

  .refs {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .refs h2 {
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  .refs ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .refs a {
    color: var(--text-muted);
    font-size: 0.92rem;
  }
</style>
