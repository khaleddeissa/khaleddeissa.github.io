---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Khaled Eissa — Software/AI Engineer. Multi-agent AI systems, ML pipelines, and applied research.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title}</title>
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <div class="bg-scene" aria-hidden="true" transition:persist>
      <svg
        class="bg-traces"
        viewBox="0 0 100 60"
        preserveAspectRatio="xMidYMid slice"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path class="trace-base" d="M -5 8 L 15 8 L 22 14 L 30 14" />
        <path class="trace-base" d="M -5 26 L 10 26 L 16 32 L 28 32" />
        <path class="trace-base" d="M 10 -5 L 10 15 L 18 22 L 18 40 L 26 48 L 26 65" />
        <path class="trace-base" d="M 70 20 L 78 20 L 84 14 L 105 14" />
        <path class="trace-base" d="M 72 44 L 82 44 L 88 50 L 105 50" />
        <path class="trace-base" d="M 90 65 L 90 45 L 82 38 L 82 20 L 74 12 L 74 -5" />

        <path class="trace-pulse trace-pulse--1" d="M -5 8 L 15 8 L 22 14 L 30 14" />
        <path class="trace-pulse trace-pulse--2" d="M 70 20 L 78 20 L 84 14 L 105 14" />
        <path class="trace-pulse trace-pulse--3" d="M 10 -5 L 10 15 L 18 22 L 18 40 L 26 48 L 26 65" />
        <path class="trace-pulse trace-pulse--4" d="M 90 65 L 90 45 L 82 38 L 82 20 L 74 12 L 74 -5" />
      </svg>
    </div>

    <header class="site-header">
      <nav class="wrap nav" transition:persist aria-label="Primary">
        <div class="nav-links">
          <a href="/" class="nav-link">Home</a>
          <a href="/blogs" class="nav-link">Blogs</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap site-footer">
      <p>&copy; {new Date().getFullYear()} Khaled Eissa.</p>
    </footer>

    <style>
      /* Ambient background: faint circuit-board-style traces (a nod to the
         infrastructure/network subject matter) with a small glowing pulse
         continuously travelling along each one, like a signal moving
         through a system. Pure SVG + CSS stroke-dashoffset animation — no
         JS, no per-frame layout cost — and automatically frozen by the
         sitewide prefers-reduced-motion rule in global.css. */
      .bg-scene {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
        contain: layout style paint;
        background: radial-gradient(ellipse 90% 70% at 50% 0%, var(--bg-elevated), var(--bg) 70%);
      }

      .bg-traces {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .trace-base {
        fill: none;
        stroke: rgba(232, 238, 240, 0.08);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
      }

            .trace-pulse {
        fill: none;
        stroke: var(--accent);
        stroke-width: 1.8;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
        opacity: 0.9;
        stroke-dasharray: 10 150;
        animation: trace-flow 7s linear infinite;
      }

      .trace-pulse--2 {
        animation-duration: 8.5s;
        animation-delay: -3s;
      }

      .trace-pulse--3 {
        animation-duration: 6.5s;
        animation-delay: -2s;
      }

      .trace-pulse--4 {
        animation-duration: 9s;
        animation-delay: -4.5s;
      }

      @keyframes trace-flow {
        to {
          stroke-dashoffset: -160;
        }
      }

      .trace-pulse--2,
      .trace-pulse--4 {
        stroke: #4f8a8f;
      }

      .trace-pulse--3 {
        stroke-dasharray: 14 360;
        animation: trace-flow-c 8s linear infinite;
        animation-delay: -5s;
      }

      .trace-pulse--5 {
        stroke-dasharray: 9 240;
        animation: trace-flow-d 6.5s linear infinite;
        animation-delay: -4s;
      }

      @keyframes trace-flow-c {
        to {
          stroke-dashoffset: -374;
        }
      }

      .site-header {
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(8px);
        z-index: 10;
      }

      .nav {
        display: flex;
        align-items: baseline;
        justify-content: flex-end;
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
      }

      .nav-links {
        display: flex;
        gap: 1.5rem;
      }

      .nav-link {
        color: var(--text-muted);
        font-size: 0.92rem;
        position: relative;
        padding-bottom: 2px;
        transition: color 0.2s ease;
      }

      .nav-link:hover,
      .nav-link:focus-visible {
        color: var(--text);
      }

      .nav-link[aria-current='page'] {
        color: var(--accent);
      }

      .site-footer {
        padding: 2.5rem var(--page-pad) 3.5rem;
        color: var(--text-faint);
        font-size: 0.85rem;
      }

      .site-footer p {
        color: var(--text-faint);
        margin: 0;
      }
    </style>

    <script>
      // Mark the current nav link so the accent highlight tracks the active page,
      // and re-run after each view-transition navigation.
      function markActiveNav() {
        const path = window.location.pathname.replace(/\/index\.html$/, '/');
        document.querySelectorAll('.nav-link').forEach((el) => {
          const href = el.getAttribute('href');
          const isHome = href === '/' && (path === '/' || path === '');
          const isBlogs = href === '/blogs' && path.startsWith('/blogs');
          if (isHome || isBlogs) {
            el.setAttribute('aria-current', 'page');
          } else {
            el.removeAttribute('aria-current');
          }
        });
      }
      markActiveNav();
      document.addEventListener('astro:page-load', markActiveNav);
    </script>
  </body>
</html>