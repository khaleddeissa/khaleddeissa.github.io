---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Khaled Eissa — Software/AI Engineer. Multi-agent AI systems, ML pipelines, and applied research.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title}</title>
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <div class="bg-scene" aria-hidden="true" transition:persist>
      <svg
        class="bg-traces"
        viewBox="0 0 100 60"
        preserveAspectRatio="xMidYMid slice"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path class="trace-base" d="M -5 8 L 15 8 L 22 14 L 45 14 L 52 20 L 105 20" />
        <path class="trace-base" d="M -5 26 L 10 26 L 16 32 L 40 32 L 46 38 L 70 38 L 76 44 L 105 44" />
        <path class="trace-base" d="M -5 50 L 20 50 L 26 40 L 50 40 L 56 30 L 80 30 L 86 20 L 105 20" />
        <path class="trace-base" d="M 20 -5 L 20 10 L 30 16 L 30 35 L 40 41 L 40 65" />
        <path class="trace-base" d="M 80 65 L 80 48 L 70 42 L 70 22 L 60 16 L 60 -5" />
        <path class="trace-base" d="M -5 54 L 30 54 L 36 58 L 60 58 L 66 54 L 105 54" />

        <path class="trace-pulse trace-pulse--1" d="M -5 8 L 15 8 L 22 14 L 45 14 L 52 20 L 105 20" />
        <path class="trace-pulse trace-pulse--2" d="M -5 26 L 10 26 L 16 32 L 40 32 L 46 38 L 70 38 L 76 44 L 105 44" />
        <path class="trace-pulse trace-pulse--4" d="M 20 -5 L 20 10 L 30 16 L 30 35 L 40 41 L 40 65" />
        <path class="trace-pulse trace-pulse--6" d="M -5 54 L 30 54 L 36 58 L 60 58 L 66 54 L 105 54" />
      </svg>
    </div>

    <header class="site-header">
      <nav class="wrap nav" transition:persist aria-label="Primary">
        <div class="nav-links">
          <a href="/" class="nav-link">Home</a>
          <a href="/blogs" class="nav-link">Blogs</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap site-footer">
      <p>&copy; {new Date().getFullYear()} Khaled Eissa.</p>
    </footer>

    <style>
      /* Ambient background: faint circuit-board-style traces (a nod to the
         infrastructure/network subject matter) with a small glowing pulse
         continuously travelling along each one, like a signal moving
         through a system. Pure SVG + CSS stroke-dashoffset animation — no
         JS, no per-frame layout cost — and automatically frozen by the
         sitewide prefers-reduced-motion rule in global.css. */
      .bg-scene {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
        contain: layout style paint;
        background: radial-gradient(ellipse 90% 70% at 50% 0%, var(--bg-elevated), var(--bg) 70%);
        /* Keep the traces lively in the side margins, but fade them out
           completely behind the readable content column (same width as
           .wrap) so they never sit under text or images and compete for
           attention. On narrow viewports the column fills the screen, so
           this naturally hides the animation there entirely. */
        --trace-fade: 4rem;
        mask-image: linear-gradient(
          to right,
          black 0,
          black calc(50% - var(--content-width) / 2 - var(--trace-fade)),
          transparent calc(50% - var(--content-width) / 2),
          transparent calc(50% + var(--content-width) / 2),
          black calc(50% + var(--content-width) / 2 + var(--trace-fade)),
          black 100%
        );
        -webkit-mask-image: linear-gradient(
          to right,
          black 0,
          black calc(50% - var(--content-width) / 2 - var(--trace-fade)),
          transparent calc(50% - var(--content-width) / 2),
          transparent calc(50% + var(--content-width) / 2),
          black calc(50% + var(--content-width) / 2 + var(--trace-fade)),
          black 100%
        );
      }

      .bg-traces {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .trace-base {
        fill: none;
        stroke: rgba(232, 238, 240, 0.08);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
      }

      .trace-pulse {
        fill: none;
        stroke: var(--accent);
        stroke-width: 1.8;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
        opacity: 0.9;
      }

      .trace-pulse--2,
      .trace-pulse--4,
      .trace-pulse--6 {
        stroke: #4f8a8f;
      }

      .trace-pulse--1 {
        stroke-dasharray: 12 300;
        animation: trace-flow-a 7s linear infinite;
        animation-delay: -1s;
      }

      .trace-pulse--2 {
        stroke-dasharray: 10 340;
        animation: trace-flow-b 9s linear infinite;
        animation-delay: -3.5s;
      }

      .trace-pulse--4 {
        stroke-dasharray: 9 240;
        animation: trace-flow-d 6s linear infinite;
        animation-delay: -2s;
      }

      .trace-pulse--6 {
        stroke-dasharray: 11 300;
        animation: trace-flow-e 7.5s linear infinite;
        animation-delay: -0.5s;
      }

      @keyframes trace-flow-a {
        to {
          stroke-dashoffset: -312;
        }
      }

      @keyframes trace-flow-b {
        to {
          stroke-dashoffset: -350;
        }
      }

      @keyframes trace-flow-d {
        to {
          stroke-dashoffset: -249;
        }
      }

      @keyframes trace-flow-e {
        to {
          stroke-dashoffset: -311;
        }
      }

      .site-header {
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(8px);
        z-index: 10;
      }

      .nav {
        display: flex;
        align-items: baseline;
        justify-content: flex-end;
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
      }

      .nav-links {
        display: flex;
        gap: 1.5rem;
      }

      .nav-link {
        color: var(--text-muted);
        font-size: 0.92rem;
        position: relative;
        padding-bottom: 2px;
        transition: color 0.2s ease;
      }

      .nav-link:hover,
      .nav-link:focus-visible {
        color: var(--text);
      }

      .nav-link[aria-current='page'] {
        color: var(--accent);
      }

      .site-footer {
        padding: 2.5rem var(--page-pad) 3.5rem;
        color: var(--text-faint);
        font-size: 0.85rem;
      }

      .site-footer p {
        color: var(--text-faint);
        margin: 0;
      }
    </style>

    <script>
      // Mark the current nav link so the accent highlight tracks the active page,
      // and re-run after each view-transition navigation.
      function markActiveNav() {
        const path = window.location.pathname.replace(/\/index\.html$/, '/');
        document.querySelectorAll('.nav-link').forEach((el) => {
          const href = el.getAttribute('href');
          const isHome = href === '/' && (path === '/' || path === '');
          const isBlogs = href === '/blogs' && path.startsWith('/blogs');
          if (isHome || isBlogs) {
            el.setAttribute('aria-current', 'page');
          } else {
            el.removeAttribute('aria-current');
          }
        });
      }
      markActiveNav();
      document.addEventListener('astro:page-load', markActiveNav);
    </script>
  </body>
</html>