---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Khaled Eissa — AI/Software Engineer. Multi-agent AI systems, ML pipelines, and applied research.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title}</title>
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <header class="site-header">
      <nav class="wrap nav" transition:persist aria-label="Primary">
        <a href="/" class="nav-mark link-underline">Khaled Eissa</a>
        <div class="nav-links">
          <a href="/" class="nav-link">Home</a>
          <a href="/blogs" class="nav-link">Blogs</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap site-footer">
      <p>&copy; {new Date().getFullYear()} Khaled Eissa.</p>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(8px);
        z-index: 10;
      }

      .nav {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
      }

      .nav-mark {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1rem;
        color: var(--text);
      }

      .nav-links {
        display: flex;
        gap: 1.5rem;
      }

      .nav-link {
        color: var(--text-muted);
        font-size: 0.92rem;
        position: relative;
        padding-bottom: 2px;
        transition: color 0.2s ease;
      }

      .nav-link:hover,
      .nav-link:focus-visible {
        color: var(--text);
      }

      .nav-link[aria-current='page'] {
        color: var(--accent);
      }

      .site-footer {
        padding: 2.5rem var(--page-pad) 3.5rem;
        color: var(--text-faint);
        font-size: 0.85rem;
      }

      .site-footer p {
        color: var(--text-faint);
        margin: 0;
      }
    </style>

    <script>
      // Mark the current nav link so the accent highlight tracks the active page,
      // and re-run after each view-transition navigation.
      function markActiveNav() {
        const path = window.location.pathname.replace(/\/index\.html$/, '/');
        document.querySelectorAll('.nav-link').forEach((el) => {
          const href = el.getAttribute('href');
          const isHome = href === '/' && (path === '/' || path === '');
          const isBlogs = href === '/blogs' && path.startsWith('/blogs');
          if (isHome || isBlogs) {
            el.setAttribute('aria-current', 'page');
          } else {
            el.removeAttribute('aria-current');
          }
        });
      }
      markActiveNav();
      document.addEventListener('astro:page-load', markActiveNav);
    </script>
  </body>
</html>
